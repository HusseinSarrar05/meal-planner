# Ignore node_modules folder (if using Node.js or a JavaScript framework)
node_modules/

# Ignore build folders
dist/
build/
out/

# Ignore environment files
.env
.env.local
.env.development
.env.production

# Ignore IDE and editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore logs and temp files
*.log
*.tmp
*.temp

# Ignore dependency caches
.cache/
.yarn/
.yarnrc

# Ignore package manager files (if not using npm)
yarn.lock
package-lock.json
pnpm-lock.yaml

# Ignore local development files
.local